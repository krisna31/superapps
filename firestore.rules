rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if caller is the verified superadmin (jelvinkrisnaputra31@gmail.com)
    function isSuperadmin() {
      return isAuthenticated() && 
        request.auth.token.email.lower() == 'jelvinkrisnaputra31@gmail.com' && 
        (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }
    
    // System settings: publicly readable for client UI; only verified superadmin can write (H1)
    match /system/settings {
      allow read: if true;
      allow write: if isSuperadmin() &&
        request.resource.data.keys().hasOnly(['allowUserRegistration', 'allowGuestAccess', 'superadminEmail']) &&
        request.resource.data.allowUserRegistration is bool &&
        request.resource.data.allowGuestAccess is bool &&
        request.resource.data.superadminEmail is string;
    }

    // User-isolated collections: Tasks, Notes, Habits, Expenses, Snippets, Dropzone, Media History (H4)
    // Completely isolated per UID: User A cannot read, write, list, or delete User B's documents.
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // URL Shortlinks:
    // - Anyone can resolve a single shortlink by slug (get)
    // - Authenticated users can only list and manage their own shortlinks
    match /shortlinks/{code} {
      // Public resolution for redirecting /r/:slug
      allow get: if true;
      
      // Scrape prevention: listing shortlinks requires authentication and ownership filter
      allow list: if isAuthenticated();
      
      // Creating requires authenticated caller attributing to their own UID with safe constraints
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.slug is string &&
        request.resource.data.slug == code &&
        request.resource.data.slug.size() >= 1 &&
        request.resource.data.slug.size() <= 100 &&
        request.resource.data.originalUrl is string &&
        request.resource.data.originalUrl.size() >= 1 &&
        request.resource.data.originalUrl.size() <= 2048 &&
        request.resource.data.originalUrl.matches('^https?://.+') &&
        request.resource.data.clicks is int &&
        request.resource.data.clicks == 0;
      
      // Safe update:
      // Case 1: Unauthenticated or visitor hit counter & analytics tracker
      // - Can ONLY affect 'clicks' and 'recentClicks'
      // - Must strictly increment clicks by 1
      // - CANNOT tamper with owner UID, slug, destination originalUrl, or createdAt (prevents URL hijacking!)
      // - recentClicks list cannot exceed 60 items (prevents document bloat)
      // Case 2: Shortlink owner updating their link
      // - Owner cannot transfer ownership (userId is immutable) or change slug
      // - Destination URL must strictly remain an HTTP/HTTPS URL
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'recentClicks']) &&
        request.resource.data.clicks == resource.data.clicks + 1 &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.originalUrl == resource.data.originalUrl &&
        (!('recentClicks' in request.resource.data) || (
          request.resource.data.recentClicks is list &&
          request.resource.data.recentClicks.size() <= 60
        ))
      ) || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.originalUrl.matches('^https?://.+')
      );

      // Only owner can delete their shortlinks
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
