rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller is the verified superadmin
    function isSuperadmin() {
      return isAuthenticated() && 
        request.auth.token.email == 'jelvinkrisnaputra31@gmail.com' && 
        request.auth.token.email_verified == true;
    }
    
    // System settings: publicly readable for client UI; only verified superadmin can write (H1)
    match /system/settings {
      allow read: if true;
      allow write: if isSuperadmin() &&
        request.resource.data.keys().hasOnly(['allowUserRegistration', 'allowGuestAccess', 'superadminEmail']) &&
        request.resource.data.allowUserRegistration is bool &&
        request.resource.data.allowGuestAccess is bool &&
        request.resource.data.superadminEmail is string;
    }

    // User-isolated collections: Tasks, Notes, Habits, Expenses, Snippets, Dropzone metadata (H4)
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // URL Shortlinks: Anyone can read; authenticated users create/manage their own (H2, H3)
    match /shortlinks/{code} {
      allow read: if true;
      
      // Creating requires attribution to caller's UID and required string fields
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.slug is string &&
        request.resource.data.originalUrl is string;
      
      // Anyone can increment click count by exactly 1 and record click analytics; owner can edit other fields
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'recentClicks']) &&
        request.resource.data.clicks == resource.data.clicks + 1
      ) || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );

      // Only owner can delete
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
