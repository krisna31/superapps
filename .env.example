# Private Vault Master Password
# In production on GitHub Actions, add VITE_MASTER_PASSWORD in GitHub Repository Secrets.
VITE_MASTER_PASSWORD=your_strong_master_password_here

# Firebase Spark Configuration (Free Tier - Optional for Cloud Sync)
# Get these credentials from your Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=AIzaSyExampleKeyPlaceholder
VITE_FIREBASE_AUTH_DOMAIN=superapps-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=superapps-demo
VITE_FIREBASE_STORAGE_BUCKET=superapps-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
