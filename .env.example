# Private Vault Master Password SHA-256 Hash
# Generate via: echo -n "your_password" | sha256sum (or via SwissKnife Hash Tool)
# In production on GitHub Actions, add VITE_MASTER_PASSWORD_HASH in GitHub Repository Secrets.
VITE_MASTER_PASSWORD_HASH=your_sha256_hash_here

# Firebase Spark Configuration (Free Tier - Optional for Cloud Sync)
# Get these credentials from your Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
