# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://superapps:superappspassword@localhost:5432/superapps_db?schema=public"

# Authentication & Security (JWT)
JWT_SECRET=superapps_ultra_secure_jwt_secret_key_change_in_production_32char
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=superapps_ultra_secure_refresh_secret_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE_MB=50
