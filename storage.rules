rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Dropzone files: Users can upload files up to 10MB into their own folder (H4)
    // Public download link allows reading if file exists
    match /dropzone/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024; // 10MB max per file
    }
  }
}
