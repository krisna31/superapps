rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Dropzone files: Users can manage files in their own folder
    // Public download link allows reading if file exists
    match /dropzone/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
